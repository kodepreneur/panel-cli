[Unit]
Description=AI-Native VPS Panel Privileged Execution Daemon (vpsd)
Documentation=https://github.com/kodepreneur/vps-panel
After=network.target nginx.service

[Service]
Type=simple
User=root
Group=panel-rpc
ExecStart=/usr/local/bin/vpsd --socket=/run/vpsd/vpsd.sock --projects-dir=/var/www/vps-panel/projects
Restart=always
RestartSec=3s
UMask=0007
LimitNOFILE=65535

# Security sandbox
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

